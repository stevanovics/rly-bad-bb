{
    "require-dev": {
        "squizlabs/php_codesniffer": "3.*",
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^5.3"
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse",
        "test": "pest"
    },
    "autoload": {
        "psr-4": {
            "RlyBadBB\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "require": {
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "laminas/laminas-httphandlerrunner": "^2.14"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
